---
// Reemplaza el Hero de Starlight (solo se usa en la portada): franja navy de ancho completo con el
// título a la izquierda y el mosaico de glifos de Datos Abiertos a la derecha. Los datos salen del
// bloque "hero" del frontmatter de src/content/docs/index.mdx.
const { title, tagline, actions = [] } = Astro.locals.starlightRoute.entry.data.hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enlace = (link) => (/^(https?:)?\//.test(link) ? link : `${base}/${link}`);

// Cada tile: glifo, color y tamaño en la grilla. Pocos tiles y grandes, con un glifo principal en el
// tile grande. La guía de instalación usa glifos de los contenedores del portal; la guía de uso, glifos
// asociados a publicar datos.
const mosaicos = {
  instalacion: [
    { g: '∞', c: 'violeta', t: 'grande' },
    { g: '≡', c: 'indigo' },
    { g: '»', c: 'claro' },
    { g: '≈', c: 'medio' },
    { g: 'á', c: 'claro' },
    { g: '•••', c: 'indigo', t: 'ancho' },
    { g: '@', c: 'medio', t: 'ancho' },
  ],
  uso: [
    { g: '↑', c: 'violeta', t: 'grande' },
    { g: '%', c: 'indigo' },
    { g: 'á', c: 'claro' },
    { g: '#', c: 'medio' },
    { g: '@', c: 'claro' },
    { g: '•••', c: 'indigo', t: 'ancho' },
    { g: '≠', c: 'medio', t: 'ancho' },
  ],
};
const tiles = Astro.url.pathname.startsWith(`${base}/uso`) ? mosaicos.uso : mosaicos.instalacion;
---
<section class="portada not-content">
  <div class="interior">
    <div class="texto">
      <div class="firma">
        <img class="logo" src={`${base}/andino-logo.png`} alt="Portal Andino" width="682" height="715" />
        <h1 id="_top">{title}</h1>
      </div>
      {tagline && <p class="bajada" set:html={tagline} />}
      <div class="acciones">
        {actions.map((a) => (
          <a class:list={['boton', { secundario: a.variant === 'minimal' || a.variant === 'secondary' }]} href={enlace(a.link)}>{a.text}</a>
        ))}
      </div>
    </div>
    <div class="mosaico" aria-hidden="true">
      {tiles.map((tile, i) => (
        <span class:list={['tile', tile.c, tile.t]} style={`--i:${i}`}>{tile.g}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .portada {
    /* Ocupa todo el ancho de la ventana aunque esté dentro de la columna de contenido. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--sl-content-pad-y, 1.5rem));
    background: var(--navy);
    color: #fff;
  }
  .interior {
    max-width: 72rem; margin: 0 auto;
    padding: clamp(3rem, 7vw, 5.5rem) var(--sl-nav-pad-x, 1.5rem);
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
  }
  /* Logo y título lado a lado, separados por una línea vertical. */
  .firma { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 2rem); }
  .logo {
    flex: none; width: clamp(6.5rem, 11vw, 9rem); height: auto;
    filter: brightness(0) invert(1);
    padding-right: clamp(1.25rem, 3vw, 2rem); border-right: 2px solid rgb(255 255 255 / .35);
  }
  h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; line-height: 1.02; letter-spacing: -.03em; color: #fff; margin: 0; }
  .bajada { font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; color: #D6D9E6; max-width: 34rem; margin: 1.25rem 0 0; }
  .acciones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .boton { padding: .85rem 1.35rem; font-weight: 700; text-decoration: none; background: #fff; color: var(--navy); }
  .boton:hover { background: var(--violeta); color: var(--navy); }
  .boton.secundario { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px rgb(255 255 255 / .55); }
  .boton.secundario:hover { box-shadow: inset 0 0 0 2px #fff; background: rgb(255 255 255 / .08); }
  .boton:focus-visible { outline: 3px solid var(--violeta); outline-offset: 3px; }

  .mosaico {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(4.5rem, 8vw, 6.5rem);
    grid-auto-flow: dense; gap: 6px;
  }
  .tile {
    display: grid; place-items: center;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-weight: 600; line-height: 1;
    animation: pulso 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * .8s);
  }
  .grande { grid-column: span 2; grid-row: span 2; font-size: clamp(3.5rem, 7vw, 6rem); }
  .ancho { grid-column: span 2; }
  .violeta { background: var(--violeta); color: var(--navy); }
  .indigo { background: var(--indigo); color: #fff; }
  .medio { background: #2E3A66; color: #AEB5D1; }
  .claro { background: var(--gris-mosaico); color: var(--navy); }

  /* Los tiles se iluminan de a uno, con un retraso según su posición. */
  @keyframes pulso {
    0%, 12%, 100% { filter: none; transform: none; }
    5% { filter: brightness(1.35) saturate(1.2); transform: translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile { animation: none; }
  }

  /* En pantallas angostas el mosaico queda debajo del texto y más compacto. */
  @media (max-width: 50rem) {
    .interior { grid-template-columns: 1fr; }
    .mosaico { grid-auto-rows: 4.25rem; }
    /* Se muestran el ∞ y los cuatro tiles chicos que lo acompañan. */
    .tile:nth-child(n + 6) { display: none; }
    .logo { width: 5.5rem; }
  }
</style>
